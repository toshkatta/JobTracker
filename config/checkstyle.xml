<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Structural code-style rules. Whitespace and line wrapping are handled by the formatter
  (config/java-formatter.xml, applied by Spotless), so this file only checks things a formatter cannot.
  Run with: ./mvnw checkstyle:check   (also runs as part of ./mvnw verify, and therefore in CI)
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- The Spring Boot entry point only has a static main method, but Spring needs to instantiate it. -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="HideUtilityClassConstructor"/>
    <property name="files" value="JobtrackerApplication\.java"/>
  </module>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!--
      Class layout: static fields, instance fields, constructors, then methods.
      Within the fields: public, protected, package-private, private.
    -->
    <module name="DeclarationOrder"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="OneTopLevelClass"/>

    <!-- Common mistakes -->
    <module name="NeedBraces"/>
    <module name="EmptyStatement"/>
    <module name="MissingOverride"/>
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
  </module>
</module>
